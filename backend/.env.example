# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional absolute SQLite path. Default: backend/data/policylens-v2.db
# DATABASE_PATH=C:/path/to/policylens-v2.db
SANCTIONS_MAX_AGE_HOURS=24
# Set true behind HTTPS; never expose HTTP cookies publicly.
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SESSION_HOURS=12
AGENT_DAILY_RUNS=30
AGENT_MAX_CONTEXT_CHARS=18000
