# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional expected provider system_fingerprint. Unreported revisions are explicit.
GROQ_MODEL_REVISION=provider-unreported
PSEUDONYMIZE_MODEL_CALLS=false
# Optional absolute SQLite path. Default: backend/data/policylens-v2.db
# DATABASE_PATH=C:/path/to/policylens-v2.db
# Optional whole-file encryption for NEW installations; existing plaintext files
# are refused. Use the documented offline migration and verify off-machine
# recovery on the target installation before enabling this on the existing pilot.
DATABASE_ENCRYPTION=none
# DATABASE_ENCRYPTION=sqlcipher4
SANCTIONS_MAX_AGE_HOURS=24
# Set true behind HTTPS; never expose HTTP cookies publicly.
COOKIE_SECURE=false
DEPLOYMENT_MODE=local
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
SESSION_HOURS=12
AGENT_DAILY_RUNS=30
AGENT_MAX_CONTEXT_CHARS=18000
# Public deployments must provision this separately before MFA enrollment.
# Keep this binary key outside database snapshots and back it up privately.
# SECURITY_KEY_PATH=/etc/policylens/security.key
# Explicit separate directory, outside DATABASE_PATH's parent:
# CHECKPOINT_DIRECTORY=/var/lib/policylens-checkpoints
CHECKPOINT_INTERVAL_SECONDS=300
# Logical deletion requires SQLCipher and durable external suppression storage.
# Preserve this complete directory and current guard digest outside rollback scope.
# DELETION_STATE_DIRECTORY=/var/lib/policylens-deletion-state
